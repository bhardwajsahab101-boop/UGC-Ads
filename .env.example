# ============================================================================
# LumeFlow Creative - Environment Configuration
# Copy this file to .env.local and populate with your own project credentials.
# NEVER commit .env.local or real secrets to Git.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Supabase (Database for Persistent Lead Storage)
# Get these from your Supabase Dashboard -> Project Settings -> API
# NOTE: DO NOT prefix with NEXT_PUBLIC_. These are server-side only.
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ----------------------------------------------------------------------------
# 2. Resend & Daily Digest Configuration
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_NOTIFICATION_EMAIL=official.launchstack@gmail.com
RESEND_FROM_EMAIL=LumeFlow Studio <onboarding@resend.dev>

# ----------------------------------------------------------------------------
# 3. Scheduled Job / Cron Security Secret
# Protects the daily digest route handler (/api/cron/digest) from unauthorized calls.
# ----------------------------------------------------------------------------
CRON_SECRET=your_random_secret_for_scheduled_cron_job
